const express=require("express"),cors=require("cors"),fs=require("fs"),path=require("path"),crypto=require("crypto"),app=express();app.use(cors({origin:"*",credentials:!0})),app.use(express.json());const LEADS_FILE=path.join(__dirname,"leads.json"),LEADS_ARCHIVE=path.join(__dirname,`leads-archive-${(new Date).getFullYear()}.jsonl`);function getLeads(){try{return JSON.parse(fs.readFileSync(LEADS_FILE,"utf8"))}catch{return{leads:[],stats:{total:0,converted:0,emailed:0},lastUpdate:(new Date).toISOString()}}}function saveLead(e,t){const s=getLeads(),n={id:`lead_${crypto.randomBytes(8).toString("hex")}`,email:e,...t,timestamp:(new Date).toISOString(),status:"new",score:calculateLeadScore(t),tags:extractTags(t)};return s.leads.push(n),s.stats.total=s.leads.length,s.lastUpdate=(new Date).toISOString(),fs.writeFileSync(LEADS_FILE,JSON.stringify(s,null,2)),fs.appendFileSync(LEADS_ARCHIVE,JSON.stringify(n)+"\n"),fetch("http://localhost:5678/webhook/leads",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(n)}).catch(()=>console.warn("[WEBHOOK] n8n unreachable")),n}function calculateLeadScore(e){let t=0;return e.email&&(t+=30),e.phone&&(t+=20),e.course&&(t+=15),e.city&&(t+=10),e.interests&&e.interests.length>0&&(t+=15),e.unemployed&&(t+=10),Math.min(100,t)}function extractTags(e){const t=[];return e.unemployed&&t.push("unemployed"),e.interests&&t.push(...e.interests),e.city&&t.push(`city:${e.city}`),t}app.post("/api/leads",(e,t)=>{const{email:s,phone:n,name:a,course:o,city:r,interests:i,unemployed:c}=e.body;if(!s||!s.includes("@"))return t.status(400).json({error:"Valid email required"});const l=saveLead(s,{phone:n,name:a,course:o,city:r,interests:i,unemployed:c});t.json({success:!0,message:"✅ Lead registrado. Recibirás un email pronto.",lead:{id:l.id,score:l.score}})}),app.get("/api/leads",(e,t)=>{const{key:s}=e.query;if(s!==process.env.ADMIN_KEY)return t.status(401).json({error:"Unauthorized"});const n=getLeads();t.json(n)}),app.patch("/api/leads/:id",(e,t)=>{const{key:s}=e.query;if(s!==process.env.ADMIN_KEY)return t.status(401).json({error:"Unauthorized"});const{status:n,notes:a}=e.body,o=getLeads(),r=o.leads.find(t=>t.id===e.params.id);if(!r)return t.status(404).json({error:"Lead not found"});r.status=n||r.status,r.notes=a||r.notes,r.updatedAt=(new Date).toISOString(),fs.writeFileSync(LEADS_FILE,JSON.stringify(o,null,2)),t.json({success:!0,lead:r})}),app.get("/api/stats",(e,t)=>{const s=getLeads(),n={total:s.leads.length,new:s.leads.filter(e=>"new"===e.status).length,contacted:s.leads.filter(e=>"contacted"===e.status).length,converted:s.leads.filter(e=>"converted"===e.status).length,avgScore:(s.leads.reduce((e,t)=>e+t.score,0)/s.leads.length||0).toFixed(1),topCourses:[...new Set(s.leads.map(e=>e.course))].slice(0,5),topCities:[...new Set(s.leads.map(e=>e.city))].slice(0,5)};t.json(n)});const PORT=process.env.PORT||3847;app.listen(PORT,()=>{console.log(`✅ Lead Capture API running on :${PORT}`),console.log(`📊 Leads DB: ${LEADS_FILE}`),console.log("🔗 Webhook to n8n: http://localhost:5678/webhook/leads")});