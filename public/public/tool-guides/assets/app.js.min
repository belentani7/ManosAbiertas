const guideId=document.documentElement.dataset.guideId,checks=[...document.querySelectorAll('input[type="checkbox"]')];try{const e=JSON.parse(localStorage.getItem(guideId)||"[]");checks.forEach((t,c)=>t.checked=Boolean(e[c]))}catch{}checks.forEach(e=>e.addEventListener("change",()=>{try{localStorage.setItem(guideId,JSON.stringify(checks.map(e=>e.checked)))}catch{}})),document.querySelector("[data-copy]")?.addEventListener("click",async()=>{const e=document.querySelector(".status");try{await navigator.clipboard.writeText(document.querySelector("code").textContent),e.textContent="Comprobacion copiada."}catch{e.textContent="Selecciona el texto y copialo manualmente."}});