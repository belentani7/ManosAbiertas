# Local database. Resolved from prisma/schema.prisma.
DATABASE_URL="file:../db/local.db"

# Optional remote AI providers. Keep keys empty until configured privately.
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="llama-3.1-8b-instant"
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="meta/llama-3.3-70b-instruct"

# Set only for a local standalone build. Netlify config sets this in netlify.toml.
NEXT_OUTPUT_MODE="standalone"
